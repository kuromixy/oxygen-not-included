---
import RangeDisplay from './RangeDisplay.astro';
import StatPill from './StatPill.astro';
import type { CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  entry: CollectionEntry<'geysers'>;
}

const { entry } = Astro.props;
const d = entry.data;

function formatName(slug: string): string {
  return slug
    .split('_')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

const slug = d.id.replaceAll('_', '-');
const imgPath = join(process.cwd(), 'public', 'images', 'geysers', `${slug}.png`);
const headerImage = existsSync(imgPath)
  ? `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}images/geysers/${slug}.png`
  : null;

const cardId = `geyser-card-${slug}`;
const stepperLevels = [0, 1, 2, 3, 4, 5];

const containerByState: Record<string, { name: string; capacity: number }> = {
  liquid: { name: 'Liquid Reservoir', capacity: 5000 },
  gas: { name: 'Gas Reservoir', capacity: 150 },
  solid: { name: 'Storage Bin', capacity: 1000 },
};
const container = containerByState[d.output_state] ?? containerByState.liquid;

// Default values seeded into new instances. The active/total period defaults are heuristic
// placeholders (~60% long-term active fraction — derived from the wiki's Avg Lifetime ÷ Avg
// Active Yield ratio, which is consistent across variants). They are NOT canonical per-variant
// averages — every player's geyser rolls its own active/total cycles. Users should overwrite
// these from their in-game tile.
const ACTIVE_PERIOD_FALLBACK = 75;
const TOTAL_PERIOD_FALLBACK = 125;
const defaults = {
  mass_per_second: d.cycle_stats.mass_per_second.avg,
  eruption_period: d.cycle_stats.eruption_period.avg,
  iteration_period: d.cycle_stats.iteration_period.avg,
  active_period_cycles: d.cycle_stats.active_period_cycles?.avg ?? ACTIVE_PERIOD_FALLBACK,
  total_period_cycles: d.cycle_stats.total_period_cycles?.avg ?? TOTAL_PERIOD_FALLBACK,
};
---

<div
  class="space-y-6"
  id={cardId}
  data-output-temp-base={d.output_temp.value}
  data-container-capacity={container.capacity}
  data-container-name={container.name}
>
  {/* ─── Reference panel (read-only) ─── */}
  <section class="border border-oni-bg-elevated rounded-xl p-5 space-y-5">
    {headerImage && (
      <img
        src={headerImage}
        alt={d.name}
        loading="lazy"
        class="w-full rounded-lg border border-oni-bg-elevated"
      />
    )}

    <div class="flex items-center gap-4">
      <div class="w-16 h-16 rounded-lg bg-oni-bg-elevated flex items-center justify-center text-2xl shrink-0" aria-hidden="true">
        🌋
      </div>
      <div>
        <h3 class="text-xl font-bold text-oni-text-primary">{d.name}</h3>
        <p class="text-xs text-oni-text-muted mt-1">Reference data from the ONI wiki.</p>
      </div>
    </div>

    {/* Output material + base temp */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <h5 class="text-xs text-oni-text-muted uppercase tracking-wider mb-2">Output Material</h5>
        <p class="text-oni-text-primary">{formatName(d.output_material)}</p>
      </div>
      <div>
        <h5 class="text-xs text-oni-text-muted uppercase tracking-wider mb-2">Base Output Temperature</h5>
        <StatPill value={d.output_temp.value} unit={`°${d.output_temp.unit}`} />
      </div>
    </div>

    {/* Cycle stat ranges (read-only) */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-4 border-t border-oni-bg-elevated">
      <RangeDisplay label="Mass per Second" range={d.cycle_stats.mass_per_second} unit="g/s" />
      <RangeDisplay label="Eruption Period" range={d.cycle_stats.eruption_period} unit="s" decimals={1} />
      <RangeDisplay label="Iteration Period" range={d.cycle_stats.iteration_period} unit="s" />
      {d.cycle_stats.active_period_cycles && (
        <RangeDisplay label="Active Period" range={d.cycle_stats.active_period_cycles} unit="cycles" decimals={1} />
      )}
      {d.cycle_stats.total_period_cycles && (
        <RangeDisplay label="Total Period (active + dormant)" range={d.cycle_stats.total_period_cycles} unit="cycles" decimals={1} />
      )}
    </div>

    {/* Compatible geotuner material (dynamic per-instance cost lives below) */}
    <div class="pt-4 border-t border-oni-bg-elevated">
      <h5 class="text-xs text-oni-text-muted uppercase tracking-wider mb-2">Compatible Geotuner Material</h5>
      <p class="text-oni-text-primary font-semibold">{d.geotuner.material}</p>
    </div>
  </section>

  {/* ─── Your Geysers panel (editable, multi-instance) ─── */}
  <section class="border border-oni-bg-elevated rounded-xl p-5 space-y-4">
    <header class="flex items-center justify-between gap-2 flex-wrap">
      <div>
        <h3 class="text-xl font-bold text-oni-text-primary">Your Geysers</h3>
        <p class="text-xs text-oni-text-muted mt-1">Copy the values from your in-game geyser tile &mdash; every vent rolls its own specific timings.</p>
      </div>
      <button
        type="button"
        data-add-instance
        class="px-3 py-1.5 rounded text-sm font-semibold bg-oni-teal/15 hover:bg-oni-teal/25 text-oni-teal border border-oni-teal/40 transition-colors"
      >
        + Add geyser
      </button>
    </header>

    <div data-instance-list class="space-y-4"></div>
  </section>

  {/* ─── Instance template ─── */}
  <template data-instance-template>
    <article class="border border-oni-bg-elevated rounded-lg p-4 space-y-4" data-instance>
      <div class="flex items-center justify-between gap-2">
        <h4 class="text-sm font-bold text-oni-text-secondary uppercase tracking-wider">
          Geyser #<span data-instance-num>1</span>
        </h4>
        <button
          type="button"
          data-remove-instance
          class="px-2 py-1 rounded text-xs text-oni-text-muted hover:text-red-400 hover:bg-red-400/10 transition-colors"
          aria-label="Remove geyser"
        >
          Remove
        </button>
      </div>

      {/* Inputs — laid out to mirror the in-game tile */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-6 gap-y-3">
        {/* Mass per second (single field) */}
        <label class="flex items-baseline gap-2 text-sm">
          <span class="text-xs text-oni-text-muted uppercase tracking-wider w-32 shrink-0">Mass per Second</span>
          <input
            type="text"
            inputmode="decimal"
            spellcheck="false"
            value={defaults.mass_per_second.toString()}
            data-stat-key="mass_per_second"
            data-stat-default={defaults.mass_per_second}
            data-stat-decimals="1"
            class="w-24 bg-oni-bg-elevated border border-oni-bg-elevated focus:border-oni-teal focus:ring-1 focus:ring-oni-teal focus:outline-none rounded px-2 py-1 font-mono text-sm text-oni-text-primary"
          />
          <span class="text-oni-text-muted text-xs">g/s</span>
        </label>

        {/* (spacer to keep grid alignment on 2-col) */}
        <span class="hidden lg:block"></span>

        {/* Eruption: X s every Y s */}
        <label class="flex items-baseline gap-2 text-sm">
          <span class="text-xs text-oni-text-muted uppercase tracking-wider w-32 shrink-0">Eruption</span>
          <input
            type="text"
            inputmode="decimal"
            spellcheck="false"
            value={defaults.eruption_period.toString()}
            data-stat-key="eruption_period"
            data-stat-default={defaults.eruption_period}
            data-stat-decimals="1"
            class="w-20 bg-oni-bg-elevated border border-oni-bg-elevated focus:border-oni-teal focus:ring-1 focus:ring-oni-teal focus:outline-none rounded px-2 py-1 font-mono text-sm text-oni-text-primary"
          />
          <span class="text-oni-text-muted text-xs">s every</span>
          <input
            type="text"
            inputmode="decimal"
            spellcheck="false"
            value={defaults.iteration_period.toString()}
            data-stat-key="iteration_period"
            data-stat-default={defaults.iteration_period}
            data-stat-decimals="1"
            class="w-20 bg-oni-bg-elevated border border-oni-bg-elevated focus:border-oni-teal focus:ring-1 focus:ring-oni-teal focus:outline-none rounded px-2 py-1 font-mono text-sm text-oni-text-primary"
          />
          <span class="text-oni-text-muted text-xs">s</span>
        </label>

        {/* (spacer) */}
        <span class="hidden lg:block"></span>

        {/* Active period: X cycles every Y cycles */}
        <label class="flex items-baseline gap-2 text-sm">
          <span class="text-xs text-oni-text-muted uppercase tracking-wider w-32 shrink-0">Active Period</span>
          <input
            type="text"
            inputmode="decimal"
            spellcheck="false"
            value={defaults.active_period_cycles.toString()}
            data-stat-key="active_period_cycles"
            data-stat-default={defaults.active_period_cycles}
            data-stat-decimals="1"
            class="w-20 bg-oni-bg-elevated border border-oni-bg-elevated focus:border-oni-teal focus:ring-1 focus:ring-oni-teal focus:outline-none rounded px-2 py-1 font-mono text-sm text-oni-text-primary"
          />
          <span class="text-oni-text-muted text-xs">cycles every</span>
          <input
            type="text"
            inputmode="decimal"
            spellcheck="false"
            value={defaults.total_period_cycles.toString()}
            data-stat-key="total_period_cycles"
            data-stat-default={defaults.total_period_cycles}
            data-stat-decimals="1"
            class="w-20 bg-oni-bg-elevated border border-oni-bg-elevated focus:border-oni-teal focus:ring-1 focus:ring-oni-teal focus:outline-none rounded px-2 py-1 font-mono text-sm text-oni-text-primary"
          />
          <span class="text-oni-text-muted text-xs">cycles</span>
        </label>
      </div>

      {/* Geotuner stepper + dynamic material cost */}
      <div class="pt-3 border-t border-oni-bg-elevated">
        <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
          <h5 class="text-xs text-oni-text-muted uppercase tracking-wider">Geotuners</h5>
          <p class="text-xs text-oni-text-muted">+20% output and temperature each &middot; 5 = 2&times; base</p>
        </div>
        <div class="flex gap-1.5" role="group" aria-label="Geotuner count">
          {stepperLevels.map((n) => (
            <button
              type="button"
              data-geotuner-step={n}
              class:list={[
                'flex-1 px-3 py-1.5 rounded font-mono text-sm font-semibold border transition-colors',
                n === 0
                  ? 'bg-oni-stat-pill-bg border-oni-teal text-oni-text-primary'
                  : 'bg-oni-bg-surface border-oni-bg-elevated text-oni-text-muted hover:text-oni-text-secondary hover:border-oni-text-muted',
              ]}
              aria-pressed={n === 0 ? 'true' : 'false'}
            >
              {n}
            </button>
          ))}
        </div>
        <p class="text-xs text-oni-text-muted mt-2">
          <span class="uppercase tracking-wider">Material cost</span>
          <span class="text-oni-text-primary font-mono font-semibold ml-2">
            <span data-calc-output="material_cost">&mdash;</span> kg {d.geotuner.material}
          </span>
          <span class="ml-1">per active phase</span>
        </p>
      </div>

      {/* Calculated outputs (4 across on desktop) */}
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 pt-3 border-t border-oni-bg-elevated">
        <div class="bg-oni-bg-elevated/50 rounded-lg p-3">
          <p class="text-xs text-oni-text-muted mb-1">Total per Active Phase</p>
          <p class="font-mono text-lg font-semibold text-oni-text-primary">
            <span data-calc-output="total_per_phase">&mdash;</span>
            <span class="text-sm text-oni-text-muted ml-1">kg</span>
          </p>
        </div>
        <div class="bg-oni-bg-elevated/50 rounded-lg p-3">
          <p class="text-xs text-oni-text-muted mb-1">{container.name}s Needed</p>
          <p class="font-mono text-lg font-semibold text-oni-text-primary">
            <span data-calc-output="containers_needed">&mdash;</span>
          </p>
        </div>
        <div class="bg-oni-bg-elevated/50 rounded-lg p-3">
          <p class="text-xs text-oni-text-muted mb-1">Average Output</p>
          <p class="font-mono text-lg font-semibold text-oni-text-primary">
            <span data-calc-output="avg_output">&mdash;</span>
            <span class="text-sm text-oni-text-muted ml-1">g/s</span>
          </p>
        </div>
        <div class="bg-oni-bg-elevated/50 rounded-lg p-3">
          <p class="text-xs text-oni-text-muted mb-1">Output Temperature</p>
          <p class="font-mono text-lg font-semibold text-oni-text-primary">
            <span data-calc-output="output_temp">&mdash;</span>
            <span class="text-sm text-oni-text-muted ml-1">°{d.output_temp.unit}</span>
          </p>
        </div>
      </div>
    </article>
  </template>
</div>

<script define:vars={{
  cardId,
  baseTemp: d.output_temp.value,
  containerCapacity: container.capacity,
  geotunerMaterialPerCycle: d.geotuner.material_per_cycle,
}}>
  (function initGeyserCalculator() {
    const card = document.getElementById(cardId);
    if (!card) return;

    const list = card.querySelector('[data-instance-list]');
    const template = card.querySelector('[data-instance-template]');
    const addBtn = card.querySelector('[data-add-instance]');
    if (!list || !template || !addBtn) return;

    const GAME_CYCLE_SECONDS = 600;

    function formatNumber(n, decimals) {
      if (!Number.isFinite(n)) return '—';
      return n.toLocaleString(undefined, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      });
    }

    function parseStatValue(input) {
      const key = input.getAttribute('data-stat-key');
      const decimals = parseInt(input.getAttribute('data-stat-decimals') ?? '0', 10);
      const fallback = parseFloat(input.getAttribute('data-stat-default') ?? '0');
      const raw = (input.value ?? '').trim().replace(/,/g, '');
      const parsed = parseFloat(raw);
      return {
        key,
        value: Number.isFinite(parsed) ? parsed : fallback,
        decimals: Number.isFinite(decimals) ? decimals : 0,
        fallback,
        parsedOk: Number.isFinite(parsed),
      };
    }

    function recomputeInstance(instance) {
      if (!instance) return;
      const inputs = instance.querySelectorAll('input[data-stat-key]');
      const state = {
        mass_per_second: 0,
        eruption_period: 0,
        iteration_period: 0,
        active_period_cycles: 0,
        total_period_cycles: 0,
      };
      inputs.forEach((input) => {
        const { key, value } = parseStatValue(input);
        if (key && key in state) state[key] = value;
      });

      const activeStep = instance.querySelector('[data-geotuner-step][aria-pressed="true"]');
      const geotunerCount = activeStep ? parseInt(activeStep.getAttribute('data-geotuner-step') ?? '0', 10) : 0;
      const gtMult = 1 + 0.2 * geotunerCount;

      // Short-scale eruption fraction (within an iteration)
      const eruptFrac = state.iteration_period > 0 ? state.eruption_period / state.iteration_period : 0;
      // Long-scale active fraction (over total period including dormancy)
      const activeFrac = state.total_period_cycles > 0 ? state.active_period_cycles / state.total_period_cycles : 0;

      // Total output during one active phase (between dormancies), in kg
      //   active phase duration (seconds) × eruption fraction × mass/s × gt mult / 1000
      const totalPerPhaseKg = (
        state.active_period_cycles * GAME_CYCLE_SECONDS *
        eruptFrac *
        state.mass_per_second * gtMult
      ) / 1000;

      const containersNeeded = containerCapacity > 0 && totalPerPhaseKg > 0
        ? Math.ceil(totalPerPhaseKg / containerCapacity)
        : 0;

      // Average output over the full cycle (active + dormant), in g/s — matches the in-game stat
      const avgOutputGperS = state.mass_per_second * gtMult * eruptFrac * activeFrac;

      const modifiedTemp = baseTemp * gtMult;

      // Geotuners run continuously through the active phase; material scales with active period.
      // material_per_cycle is kg per game cycle. active_period_cycles is in cycles → multiply directly.
      const materialCost = geotunerCount > 0 && state.active_period_cycles > 0
        ? geotunerMaterialPerCycle * state.active_period_cycles * geotunerCount
        : 0;

      const out = (key) => instance.querySelector(`[data-calc-output="${key}"]`);
      if (out('total_per_phase')) out('total_per_phase').textContent = formatNumber(totalPerPhaseKg, 1);
      if (out('containers_needed')) out('containers_needed').textContent = formatNumber(containersNeeded, 0);
      if (out('avg_output')) out('avg_output').textContent = formatNumber(avgOutputGperS, 1);
      if (out('output_temp')) out('output_temp').textContent = formatNumber(modifiedTemp, 1);
      if (out('material_cost')) out('material_cost').textContent = formatNumber(materialCost, 1);
    }

    function setGeotuner(instance, n) {
      const buttons = instance.querySelectorAll('[data-geotuner-step]');
      buttons.forEach((btn) => {
        const value = parseInt(btn.getAttribute('data-geotuner-step') ?? '0', 10);
        const active = value === n;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-oni-stat-pill-bg', active);
        btn.classList.toggle('border-oni-teal', active);
        btn.classList.toggle('text-oni-text-primary', active);
        btn.classList.toggle('bg-oni-bg-surface', !active);
        btn.classList.toggle('border-oni-bg-elevated', !active);
        btn.classList.toggle('text-oni-text-muted', !active);
      });
      recomputeInstance(instance);
    }

    function renumberInstances() {
      const instances = list.querySelectorAll('[data-instance]');
      instances.forEach((inst, i) => {
        const num = inst.querySelector('[data-instance-num]');
        if (num) num.textContent = String(i + 1);
        const removeBtn = inst.querySelector('[data-remove-instance]');
        if (removeBtn) {
          if (instances.length === 1) {
            removeBtn.setAttribute('disabled', '');
            removeBtn.classList.add('opacity-0', 'pointer-events-none');
          } else {
            removeBtn.removeAttribute('disabled');
            removeBtn.classList.remove('opacity-0', 'pointer-events-none');
          }
        }
      });
    }

    function addInstance() {
      const node = template.content.firstElementChild.cloneNode(true);
      list.appendChild(node);
      renumberInstances();
      recomputeInstance(node);
    }

    list.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (!target.hasAttribute('data-stat-key')) return;
      const instance = target.closest('[data-instance]');
      if (instance) recomputeInstance(instance);
    });

    list.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (!target.hasAttribute('data-stat-key')) return;
      const { value, decimals, fallback, parsedOk } = parseStatValue(target);
      target.value = (parsedOk ? value : fallback).toFixed(decimals);
      const instance = target.closest('[data-instance]');
      if (instance) recomputeInstance(instance);
    });

    list.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (!target.hasAttribute('data-stat-key')) return;
      event.preventDefault();
      target.blur();
    });

    list.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;

      const stepBtn = target.closest('[data-geotuner-step]');
      if (stepBtn) {
        const instance = stepBtn.closest('[data-instance]');
        const n = parseInt(stepBtn.getAttribute('data-geotuner-step') ?? '0', 10);
        if (instance) setGeotuner(instance, n);
        return;
      }

      const removeBtn = target.closest('[data-remove-instance]');
      if (removeBtn) {
        const instance = removeBtn.closest('[data-instance]');
        if (!instance) return;
        const remaining = list.querySelectorAll('[data-instance]').length;
        if (remaining <= 1) return;
        instance.remove();
        renumberInstances();
      }
    });

    addBtn.addEventListener('click', addInstance);

    addInstance();
  })();
</script>
