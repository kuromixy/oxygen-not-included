---
import RangeStat from './RangeStat.astro';
import StatPill from './StatPill.astro';
import type { CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  entry: CollectionEntry<'geysers'>;
}

const { entry } = Astro.props;
const d = entry.data;

function formatName(slug: string): string {
  return slug
    .split('_')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

const slug = d.id.replaceAll('_', '-');
const imgPath = join(process.cwd(), 'public', 'images', 'geysers', `${slug}.png`);
const headerImage = existsSync(imgPath)
  ? `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}images/geysers/${slug}.png`
  : null;

const cardId = `geyser-card-${slug}`;
const stepperLevels = [0, 1, 2, 3, 4, 5];

const containerByState: Record<string, { name: string; capacity: number }> = {
  liquid: { name: 'Liquid Reservoir', capacity: 5000 },
  gas: { name: 'Gas Reservoir', capacity: 150 },
  solid: { name: 'Storage Bin', capacity: 1000 },
};
const container = containerByState[d.output_state] ?? containerByState.liquid;
---

<div
  class="border border-oni-bg-elevated rounded-xl p-5 space-y-6"
  id={cardId}
  data-output-temp-base={d.output_temp.value}
  data-container-capacity={container.capacity}
  data-container-name={container.name}
>
  {headerImage && (
    <img
      src={headerImage}
      alt={d.name}
      loading="lazy"
      class="w-full rounded-lg border border-oni-bg-elevated"
    />
  )}

  {/* Top section: icon + name */}
  <div class="flex items-center gap-4">
    <div class="w-20 h-20 rounded-lg bg-oni-bg-elevated flex items-center justify-center text-3xl shrink-0" aria-hidden="true">
      🌋
    </div>
    <div>
      <h3 class="text-xl font-bold text-oni-text-primary">{d.name}</h3>
      <p class="text-xs text-oni-text-muted mt-1">Enter your geyser&apos;s specific values below &mdash; the calculator updates live.</p>
    </div>
  </div>

  {/* Top stats: Output Material + Output Temperature */}
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <h4 class="text-xs text-oni-text-muted uppercase tracking-wider mb-2">Output Material</h4>
      <p class="text-oni-text-primary text-lg">{formatName(d.output_material)}</p>
    </div>
    <div>
      <h4 class="text-xs text-oni-text-muted uppercase tracking-wider mb-2">Output Temperature</h4>
      <StatPill value={d.output_temp.value} unit={`°${d.output_temp.unit}`} />
    </div>
  </div>

  {/* Middle: cycle stat ranges (4 rows) */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-oni-bg-elevated">
    <RangeStat
      label="Active Eruption Period"
      range={d.cycle_stats.eruption_period}
      unit="s"
      statKey="eruption_period"
      decimals={1}
    />
    <RangeStat
      label="Active Cycle Length"
      range={d.cycle_stats.active_cycle}
      unit="s"
      statKey="active_cycle"
    />
    <RangeStat
      label="Dormancy"
      range={d.cycle_stats.dormancy}
      unit="s"
      statKey="dormancy"
    />
    <RangeStat
      label="Mass per Second"
      range={d.cycle_stats.mass_per_second}
      unit="g/s"
      statKey="mass_per_second"
    />
  </div>

  {/* Geotuner stepper */}
  <div class="pt-4 border-t border-oni-bg-elevated">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
      <h4 class="text-xs text-oni-text-muted uppercase tracking-wider">Geotuners</h4>
      <p class="text-xs text-oni-text-muted">+20% output and temperature each &middot; 5 = 2&times; base</p>
    </div>
    <div class="flex gap-1.5" role="group" aria-label="Geotuner count">
      {stepperLevels.map((n) => (
        <button
          type="button"
          data-geotuner-step={n}
          class:list={[
            'flex-1 px-3 py-1.5 rounded font-mono text-sm font-semibold border transition-colors',
            n === 0
              ? 'bg-oni-stat-pill-bg border-oni-teal text-oni-text-primary'
              : 'bg-oni-bg-surface border-oni-bg-elevated text-oni-text-muted hover:text-oni-text-secondary hover:border-oni-text-muted',
          ]}
          aria-pressed={n === 0 ? 'true' : 'false'}
        >
          {n}
        </button>
      ))}
    </div>
    <p class="text-xs text-oni-text-muted mt-2">
      Material per cycle:
      <span class="text-oni-text-secondary font-semibold ml-1">
        <span data-geotuner-material-total={d.geotuner.material_per_cycle}>0</span>
        kg
      </span>
      <span class="ml-1">{d.geotuner.material}</span>
      <span class="text-oni-text-muted">({d.geotuner.material_per_cycle} kg &times; <span data-geotuner-count>0</span>)</span>
    </p>
  </div>

  {/* Computed outputs (calculator) */}
  <div class="pt-4 border-t border-oni-bg-elevated">
    <h4 class="text-xs text-oni-text-muted uppercase tracking-wider mb-3">Calculated Output (your world)</h4>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <div class="bg-oni-bg-elevated/50 rounded-lg p-3">
        <p class="text-xs text-oni-text-muted mb-1">Total per Active Phase</p>
        <p class="font-mono text-lg font-semibold text-oni-text-primary">
          <span data-calc-output="total_per_phase">&mdash;</span>
          <span class="text-sm text-oni-text-muted ml-1">kg</span>
        </p>
        <p class="text-xs text-oni-text-muted mt-1">mass/s &times; eruption period</p>
      </div>
      <div class="bg-oni-bg-elevated/50 rounded-lg p-3">
        <p class="text-xs text-oni-text-muted mb-1">{container.name}s Needed</p>
        <p class="font-mono text-lg font-semibold text-oni-text-primary">
          <span data-calc-output="containers_needed">&mdash;</span>
          <span class="text-sm text-oni-text-muted ml-1">&times; {container.capacity.toLocaleString()} kg</span>
        </p>
        <p class="text-xs text-oni-text-muted mt-1">to buffer one active phase</p>
      </div>
      <div class="bg-oni-bg-elevated/50 rounded-lg p-3">
        <p class="text-xs text-oni-text-muted mb-1">Avg per Cycle (long term)</p>
        <p class="font-mono text-lg font-semibold text-oni-text-primary">
          <span data-calc-output="avg_per_cycle">&mdash;</span>
          <span class="text-sm text-oni-text-muted ml-1">kg/cycle</span>
        </p>
        <p class="text-xs text-oni-text-muted mt-1">averaged over active + dormant time</p>
      </div>
      <div class="bg-oni-bg-elevated/50 rounded-lg p-3">
        <p class="text-xs text-oni-text-muted mb-1">Output Temperature</p>
        <p class="font-mono text-lg font-semibold text-oni-text-primary">
          <span data-calc-output="output_temp">&mdash;</span>
          <span class="text-sm text-oni-text-muted ml-1">°{d.output_temp.unit}</span>
        </p>
        <p class="text-xs text-oni-text-muted mt-1">base &times; geotuner multiplier</p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ cardId, baseTemp: d.output_temp.value, containerCapacity: container.capacity }}>
  (function initGeyserCalculator() {
    const card = document.getElementById(cardId);
    if (!card) return;

    const editableStats = card.querySelectorAll('[data-stat-key]');
    const stepButtons = card.querySelectorAll('[data-geotuner-step]');
    const outputs = {
      total_per_phase: card.querySelector('[data-calc-output="total_per_phase"]'),
      containers_needed: card.querySelector('[data-calc-output="containers_needed"]'),
      avg_per_cycle: card.querySelector('[data-calc-output="avg_per_cycle"]'),
      output_temp: card.querySelector('[data-calc-output="output_temp"]'),
    };
    const countDisplay = card.querySelector('[data-geotuner-count]');
    const materialTotal = card.querySelector('[data-geotuner-material-total]');
    const materialPerTuner = materialTotal
      ? parseFloat(materialTotal.getAttribute('data-geotuner-material-total') ?? '0')
      : 0;

    let geotunerCount = 0;

    const state = {};
    editableStats.forEach((el) => {
      const key = el.getAttribute('data-stat-key');
      const avg = parseFloat(el.getAttribute('data-stat-avg') ?? '0');
      if (key) state[key] = avg;
    });

    const GAME_CYCLE_SECONDS = 600;

    function formatNumber(n, decimals) {
      if (!Number.isFinite(n)) return '—';
      return n.toLocaleString(undefined, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      });
    }

    function recompute() {
      const gtMult = 1 + 0.2 * geotunerCount;
      const eruption = state.eruption_period ?? 0;
      const activeCycle = state.active_cycle ?? 0;
      const dormancy = state.dormancy ?? 0;
      const massPerSec = state.mass_per_second ?? 0;

      // Total output during one active phase (between dormancies):
      // mass_per_second × eruption_period × geotuner multiplier, converted g → kg
      const totalPerPhaseKg = (massPerSec * eruption * gtMult) / 1000;

      // Containers needed to buffer one active phase
      const containersNeeded = containerCapacity > 0 && totalPerPhaseKg > 0
        ? Math.ceil(totalPerPhaseKg / containerCapacity)
        : 0;

      // Long-term average across the full active + dormant cycle
      const totalCycleSeconds = activeCycle + dormancy;
      const avgPerCycle = totalCycleSeconds > 0
        ? (massPerSec * eruption * gtMult * GAME_CYCLE_SECONDS) / totalCycleSeconds / 1000
        : 0;
      const modifiedTemp = baseTemp * gtMult;

      if (outputs.total_per_phase) outputs.total_per_phase.textContent = formatNumber(totalPerPhaseKg, 1);
      if (outputs.containers_needed) outputs.containers_needed.textContent = formatNumber(containersNeeded, 0);
      if (outputs.avg_per_cycle) outputs.avg_per_cycle.textContent = formatNumber(avgPerCycle, 2);
      if (outputs.output_temp) outputs.output_temp.textContent = formatNumber(modifiedTemp, 1);
    }

    function handleStatInput(el) {
      const key = el.getAttribute('data-stat-key');
      if (!key) return;
      const raw = (el.value ?? '').trim().replace(/,/g, '');
      const parsed = parseFloat(raw);
      if (Number.isFinite(parsed)) {
        state[key] = parsed;
      }
      recompute();
    }

    function commitStatValue(el) {
      const key = el.getAttribute('data-stat-key');
      if (!key) return;
      const decimals = parseInt(el.getAttribute('data-stat-decimals') ?? '0', 10);
      const raw = (el.value ?? '').trim().replace(/,/g, '');
      const parsed = parseFloat(raw);
      if (Number.isFinite(parsed)) {
        state[key] = parsed;
        el.value = parsed.toFixed(Number.isFinite(decimals) ? decimals : 0);
      } else {
        const fallback = parseFloat(el.getAttribute('data-stat-avg') ?? '0');
        state[key] = fallback;
        el.value = fallback.toFixed(Number.isFinite(decimals) ? decimals : 0);
      }
      recompute();
    }

    editableStats.forEach((el) => {
      el.addEventListener('input', () => handleStatInput(el));
      el.addEventListener('change', () => commitStatValue(el));
      el.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') {
          event.preventDefault();
          el.blur();
        }
      });
    });

    function setGeotuner(n) {
      geotunerCount = n;
      stepButtons.forEach((btn) => {
        const value = parseInt(btn.getAttribute('data-geotuner-step') ?? '0', 10);
        const active = value === n;
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        btn.classList.toggle('bg-oni-stat-pill-bg', active);
        btn.classList.toggle('border-oni-teal', active);
        btn.classList.toggle('text-oni-text-primary', active);
        btn.classList.toggle('bg-oni-bg-surface', !active);
        btn.classList.toggle('border-oni-bg-elevated', !active);
        btn.classList.toggle('text-oni-text-muted', !active);
      });
      if (countDisplay) countDisplay.textContent = String(n);
      if (materialTotal) materialTotal.textContent = String(materialPerTuner * n);
      recompute();
    }

    stepButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const value = parseInt(btn.getAttribute('data-geotuner-step') ?? '0', 10);
        setGeotuner(value);
      });
    });

    recompute();
  })();
</script>
