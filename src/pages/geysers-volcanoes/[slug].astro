---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeyserDataCard from '../../components/GeyserDataCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const geysers = await getCollection('geysers');
  return geysers.map((geyser) => ({
    params: { slug: geyser.data.id.replaceAll('_', '-') },
    props: { geyser },
  }));
}

interface Props {
  geyser: CollectionEntry<'geysers'>;
}

const { geyser } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={`${geyser.data.name} -- ONI Reference`}>
  {/* Breadcrumb */}
  <nav class="text-sm text-oni-text-muted mb-4" aria-label="Breadcrumb">
    <a href={`${baseUrl}geysers-volcanoes/`} class="hover:text-oni-teal transition-colors">Geysers &amp; Volcanoes</a>
    <span class="mx-1">&gt;</span>
    <span class="text-oni-text-secondary">{geyser.data.name}</span>
  </nav>

  {/* Page heading */}
  <section class="mb-8">
    <h1 data-pagefind-meta="category:Geysers" class="text-3xl md:text-4xl font-bold text-oni-text-primary">{geyser.data.name}</h1>
  </section>

  {/* Lean structured data card */}
  <GeyserDataCard entry={geyser} />
</BaseLayout>
